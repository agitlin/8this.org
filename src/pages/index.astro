---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAboutArticle } from '../lib/content';

// The home page renders whichever article is tagged `about` (enforced unique
// at build time in lib/content.ts), so it stays editable in the CMS.
const about = await getAboutArticle();
const { Content } = about ? await about.render() : { Content: null };
---
<BaseLayout title="8this.org" hideHeader description={about?.data.description}>
  <div class="hero">
    <h1>8this.</h1>
  </div>
  <article class="prose">
    {Content ? <Content /> : <p>No article is tagged <code>about</code> yet.</p>}
  </article>
</BaseLayout>
