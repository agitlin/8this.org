---
import '../styles/global.css';
export interface Props { title: string; description?: string; hideHeader?: boolean; }
const { title, hideHeader = false, description = '8this.org — pragmatic creative cooking, diet, and the art of nourishing yourself well.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | 8this.org</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <div class="dedication" id="dedication">
    For Milla — a slightly belated 24th birthday present. <em>With love, Dad.</em>
  </div>
  <script is:inline>
    // Fades away on its own (see .dedication in global.css); a click dismisses it sooner.
    document.getElementById('dedication').addEventListener('click', function () { this.remove(); });
  </script>
  {!hideHeader && (
    <header class="site-header">
      <div class="site-title"><a href="/">8this.org</a></div>
    </header>
  )}
  <main><slot /></main>
  <footer class="site-footer">© {new Date().getFullYear()} 8this.org</footer>
</body>
</html>
